{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/tienda/",
      "destination": "/#gama",
      "permanent": true
    },
    {
      "source": "/shop/",
      "destination": "/#gama",
      "permanent": true
    },
    {
      "source": "/carrito/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/finalizar-compra/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mi-cuenta/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/moto/",
      "destination": "/#gama",
      "permanent": true
    },
    {
      "source": "/categoria-producto/royal-enfield/",
      "destination": "/#gama",
      "permanent": true
    },
    {
      "source": "/categoria-producto/:slug/",
      "destination": "/#gama",
      "permanent": true
    },
    {
      "source": "/producto/:slug/",
      "destination": "/moto/:slug/",
      "permanent": true
    },
    {
      "source": "/politica-de-privacidad/",
      "destination": "/politicas-de-privacidad/",
      "permanent": true
    },
    {
      "source": "/politicas-de-cookies/",
      "destination": "/politica-de-cookies/",
      "permanent": true
    },
    {
      "source": "/hello-world/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/prueba/",
      "destination": "/solicitud-de-prueba/",
      "permanent": true
    },
    {
      "source": "/nosotros/",
      "destination": "/concesionario-royal-enfield-en-madrid-sur/",
      "permanent": true
    },
    {
      "source": "/feed/",
      "destination": "/blog/feed.xml",
      "permanent": true
    },
    {
      "source": "/wp-admin/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/wp-login.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/manuales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}